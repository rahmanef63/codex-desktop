#!/usr/bin/env bash
# Which Codex capabilities actually execute, per provider.
#
#   codex-caps-quicktest            # both providers
#   codex-caps-quicktest 9router    # one provider
#   codex-caps-quicktest --list     # print the matrix without running anything
#
# Capabilities are named by what the user gets, not by tool name, because the tool
# name is exactly what breaks on the gateway: the same `exec` custom tool arrives as
# `functions` when the catalog is wrong.
set -uo pipefail

CODEX_EXE="${CODEX_EXE:-C:\\Users\\rahma\\AppData\\Local\\OpenAI\\Codex\\bin\\22cfb1d302613eae\\codex.exe}"
WORKDIR="${WORKDIR:-C:\\Users\\rahma\\Documents\\probe}"
# Same directory from inside WSL, so a probe can inspect what actually landed on disk.
WORKDIR_WSL="${WORKDIR_WSL:-/mnt/c/Users/rahma/Documents/probe}"
# Rollouts, read after a probe to find out what the model actually did.
SESSION_DIR_WSL="${SESSION_DIR_WSL:-/mnt/c/Users/rahma/.codex-clone/sessions}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../scripts" && pwd)"
WHICH="${1:-both}"

if [ "$WHICH" = "--list" ]; then
	cat <<'EOF'
capability         chatgpt                       9router
-----------------  ----------------------------  ----------------------------
chat               pass                          pass
exec / shell       pass                          pass
file write+read    pass                          pass
apply_patch        pass                          pass
artifact html      pass                          pass
parallel tools     pass                          pass (via Promise.allSettled in exec)
sub-agents         pass (collab: Wait)           pass on cx/gpt-6.1-sol only;
                                                 deepseek: unsupported call
images (CLI -i)    pass                          cx: 3/3 pass; ctx: 1/3
                                                 see PROGRESS 5i
web search         pass                          not available (hosted tool)
clock              pass                          not available (namespace tool)
browser (in-app)   blocked: no app host          blocked: no app host
computer use       blocked: per-app approval     blocked: per-app approval
EOF
	exit 0
fi

PASS=0; FAIL=0
ok()  { printf '  PASS  %-22s %s\n' "$1" "$2"; PASS=$((PASS + 1)); }
bad() { printf '  FAIL  %-22s %s\n' "$1" "$2"; FAIL=$((FAIL + 1)); }
skip(){ printf '  SKIP  %-22s %s\n' "$1" "$2"; }

# probe <capability> <expect> <flag> <prompt> [skip_reason_on_fail]
probe() {
	local cap="$1" want="$2" flag="$3" prompt="$4" hint="${5:-}" out
	out=$(powershell.exe -NoProfile -Command \
		"& '$CODEX_EXE' $flag exec --sandbox workspace-write --skip-git-repo-check -C '$WORKDIR' '$prompt'" 2>&1)
	if grep -qF "$want" <<<"$out"; then ok "$cap" "verified"; return; fi
	bad "$cap" "${hint:-wanted $want}"
	if grep -q "unsupported call: collaboration" <<<"$out"; then
		printf '        -> namespace flattened: this upstream model cannot do sub-agents; use cx/gpt-6.1-sol\n'
	elif grep -q "unsupported call" <<<"$out"; then
		printf '        -> gateway mangled tool names (tool_mode / use_responses_lite)\n'
	elif grep -q "no such tool\|not available\|unknown tool" <<<"$out"; then
		printf '        -> tool not exposed by this provider\n'
	elif grep -q "is denied" <<<"$out"; then
		printf '        -> sandbox denied the write, not a missing tool\n'
	fi
}

# probe2 <capability> <want1> <want2> <flag> <prompt> [hint]
probe2() {
	local cap="$1" want1="$2" want2="$3" flag="$4" prompt="$5" hint="${6:-}" out
	out=$(powershell.exe -NoProfile -Command \
		"& '$CODEX_EXE' $flag exec --sandbox workspace-write --skip-git-repo-check -C '$WORKDIR' '$prompt'" 2>&1)
	if grep -qF "$want1" <<<"$out" && grep -qF "$want2" <<<"$out"; then ok "$cap" "verified"; return; fi
	bad "$cap" "${hint:-wanted $want1 and $want2}"
	if grep -q "unsupported call" <<<"$out"; then
		printf '        -> gateway mangled tool names (tool_mode / use_responses_lite)\n'
	elif grep -q "no such tool\|not available\|unknown tool" <<<"$out"; then
		printf '        -> tool not exposed by this provider\n'
	elif grep -q "is denied" <<<"$out"; then
		printf '        -> sandbox denied the write, not a missing tool\n'
	fi
}

# probe_re <capability> <regex> <flag> <prompt> [hint]
# For tools that return real data (a timestamp, a version) rather than an echo of a token.
probe_re() {
	local cap="$1" re="$2" flag="$3" prompt="$4" hint="${5:-}" out
	out=$(powershell.exe -NoProfile -Command \
		"& '$CODEX_EXE' $flag exec --sandbox workspace-write --skip-git-repo-check -C '$WORKDIR' '$prompt'" 2>&1)
	if grep -qE "$re" <<<"$out"; then ok "$cap" "verified"; return; fi
	bad "$cap" "${hint:-no match for /$re/}"
	if grep -q "unsupported call" <<<"$out"; then
		printf '        -> gateway mangled tool names (tool_mode / use_responses_lite)\n'
	fi
}

# probe_image <flag>
# Proves the image arrived AT THE MODEL as an image, not as a fallback disk read.
#
# Size is the load-bearing variable (PROGRESS 5f): a 900x300 PNG survives every upstream, so
# a small fixture makes this probe pass during the very incident it exists to catch. The
# fixture is therefore full-page-screenshot sized, ~1 MB, which is what actually failed.
#
# Two assertions:
#   1. the marker is printed   -> the model saw the pixels and finished the turn
#   2. the turn did not blow up -> ctx/* can name the marker but never answers
#
# What this probe deliberately does NOT claim (corrected 2026-11-01, measured):
#   - "ctx/* never receives the image" is FALSE. It receives it, and can print the marker.
#   - "the model swaps to kimi" is one observed symptom, not the mechanism; it did not
#     reproduce here.
# What was actually measured on this fixture, 3 runs each:
#   cx/gpt-6.1-sol   3/3 pass,  ~17.3k tokens, marker correct
#   ctx/...deepseek  1/3 pass,  failures at 10.9k (view_image, no answer) and 256k (loop)
# So a FAIL here is a true failure, but a PASS on ctx/* does not clear it. This is a real
# gate for cx/* (the shipped default) and a smoke test elsewhere.
# The marker is 6 random characters drawn as pixels, so it cannot be guessed from a filename.
probe_image() {
	local flag="$1" out marker png="$WORKDIR_WSL/cap-image-big.png" gen
	if ! command -v powershell.exe >/dev/null; then
		skip "images (CLI -i)" "powershell not reachable, cannot generate the fixture"
		return
	fi
	local script_win
	script_win=$(wslpath -w "$SCRIPT_DIR/mk-probe-image.ps1")
	gen=$(powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$script_win" -Out "$WORKDIR\\cap-image-big.png" 2>&1)
	marker=$(head -1 <<<"$gen" | tr -d '\r')
	if [ ${#marker} -ne 6 ]; then
		skip "images (CLI -i)" "could not generate the probe PNG: ${gen:0:80}"
		return
	fi


	local tok
	# `-i` is variadic, so the prompt must come after `--` or it is eaten as another image path.
	out=$(powershell.exe -NoProfile -Command \
		"& '$CODEX_EXE' $flag exec --sandbox workspace-write --skip-git-repo-check -C '$WORKDIR' -i '$WORKDIR\\cap-image-big.png' -- 'transcribe the exact text visible in the attached image and print it on its own line prefixed with CAP-IMAGE:'" 2>&1)

	if grep -qF "CAP-IMAGE: $marker" <<<"$out"; then
		ok "images (CLI -i)" "6-char pixel marker read back"
		return
	fi
	bad "images (CLI -i)" "expected CAP-IMAGE: $marker"

	if grep -qi "exceeded max context length\|prompt too long" <<<"$out"; then
		printf '        -> base64 tokenised as text (PROGRESS 5f): use cx/* for images\n'
	elif grep -qi "kimi" <<<"$out"; then
		printf '        -> upstream swapped to kimi (PROGRESS 5f)\n'
	fi
	# The measured failure is not "the image never arrived": ctx/* does receive it and can even
	# name the marker in its reasoning, then degenerates and never answers. Report the number,
	# because that is the discriminator — cx finishes this turn in ~17k tokens.
	tok=$(tr -d ' \n' <<<"$out" | grep -oE "tokens used[0-9,]+" | tail -1 | tr -dc '0-9')
	if [ -n "$tok" ] && [ "$tok" -gt 100000 ]; then
		printf '        -> turn degenerated: %s tokens and no answer; the image was re-sent each turn\n' "$tok"
	fi
	local rollout
	rollout=$(ls -t "$SESSION_DIR_WSL"/*.jsonl 2>/dev/null | head -1)
	if [ -n "$rollout" ] && grep -q "view_image" "$rollout"; then
		printf '        -> it fell back to view_image, which reads the file from disk instead\n'
	fi
}

run() {
	local name="$1" flag="$2"
	printf '\n--- %s\n' "$name"

	probe "chat"            "CAP-CHAT-OK"   "$flag" 'reply with exactly: CAP-CHAT-OK'
	probe "exec"            "CAP-EXEC-OK"   "$flag" 'run the shell command: echo CAP-EXEC-OK'

	# File write + read back: the thing an artifact actually is on disk.
	probe "file write+read" "CAP-FILE-OK"   "$flag" \
		"write a file named cap-probe.txt containing the exact text CAP-FILE-OK, then read it back and print it"

	# apply_patch: edit an existing file, then verify the file itself. Asking the model to
	# print the result proves the model can type, not that the patch landed.
	probe "apply_patch"     "CAP-PATCH-OK"  "$flag" \
		"there is a file named cap-patch.txt in the working directory containing the single line OLD; use apply_patch to change that line to CAP-PATCH-OK, then print the file content"
	if [ "$(cat "$WORKDIR_WSL/cap-patch.txt" 2>/dev/null | tr -d '\r\n')" = "CAP-PATCH-OK" ]; then
		ok "apply_patch (on disk)" "file content confirmed"
	else
		bad "apply_patch (on disk)" "file still reads: $(cat "$WORKDIR_WSL/cap-patch.txt" 2>/dev/null | tr -d '\r\n' | head -c 40)"
	fi

	# HTML artifact: a fragment written to a durable path, which is what the visualize
	# skill produces. Nothing here needs a special tool, so both providers should pass.
	probe "artifact html"   "cap-visual.html" "$flag" \
		"create a file named cap-visual.html containing a small HTML fragment with a div whose text is CAP-VISUAL-OK, then confirm the path exists"
	if grep -q "CAP-VISUAL-OK" "$WORKDIR_WSL/cap-visual.html" 2>/dev/null; then
		ok "artifact html (on disk)" "fragment content confirmed"
	else
		bad "artifact html (on disk)" "file missing or empty"
	fi

	probe2 "parallel tools" "PARA-A" "PARA-B" "$flag" \
		'using parallel tool calls, run these two shell commands at the same time: echo PARA-A and echo PARA-B, then print both outputs'

	probe "sub-agents" "collab:" "$flag" \
		'spawn a sub-agent to compute 7*6, wait for it, and print the answer'

	probe_image "$flag"

	if [ "$name" = "chatgpt" ]; then
		# These return real data, so the probe looks for the shape of an answer, not a marker.
		probe_re "web search" '[0-9]{1,3}\.[0-9]' "$flag" \
			'use web search to find the current Node.js LTS major version and print just the number' \
			"no version-like number returned"
		probe_re "clock" '[0-9]{2}:[0-9]{2}:[0-9]{2}|[0-9]{4}-[0-9]{2}-[0-9]{2}' "$flag" \
			'use the clock tool to tell me the current UTC time and print it' \
			"no timestamp returned"
	else
		skip "web search"  "hosted OpenAI tool, no gateway equivalent"
		skip "clock"       "namespace tool, no gateway equivalent"
	fi
	skip "browser (in-app)" "blocked: needs an app host pipe; CLI has none"
	skip "computer use"     "blocked: per-app approval happens in the ChatGPT UI"
}

printf '\n=== codex capability matrix ===\n'
mkdir -p "$WORKDIR_WSL"
cd "$WORKDIR_WSL" || exit 1
printf 'OLD\n' > cap-patch.txt

case "$WHICH" in
chatgpt) run "chatgpt" "" ;;
9router) run "9router" "-p 9router" ;;
*)
	run "chatgpt" ""
	run "9router" "-p 9router"
	;;
esac

printf '\n=== %d passed, %d failed ===\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
