#!/usr/bin/env bash
# Quick feature check for the codex-clone-placeholder repo.
#
#   codex-clone-quicktest            # build + boot + probe endpoints + one browser smoke
#   codex-clone-quicktest --no-build # reuse the current build
#
# Exits non-zero on the first failed check so it can gate a commit.
set -uo pipefail
# Repo override via REPO. The default is Rahman's checkout; anywhere else it will simply not
# exist, so say that instead of exiting 1 with no output — on macOS this is the first thing a
# reader hits, and silence reads like a bug in the script.
REPO_DIR="${REPO:-/home/rahman/projects/lara/codex-clone-placeholder}"
if [ ! -d "$REPO_DIR" ]; then
	printf 'codex-clone-quicktest: no repo at %s\n' "$REPO_DIR" >&2
	printf '  set REPO=/path/to/codex-clone-placeholder\n' >&2
	exit 1
fi
cd "$REPO_DIR" || exit 1

PORT="${PORT:-4198}"
BASE="http://127.0.0.1:${PORT}"
PASS=0
FAIL=0
SKIP=0
PID=""
# State file read by qcheck so its verdict line can say `ok (1 skip)` rather than `ok`.
SKIP_FILE="${TMPDIR:-/tmp}/codex-clone-quicktest.skips"

cleanup() {
	[ -n "$PID" ] && kill "$PID" 2>/dev/null
	wait "$PID" 2>/dev/null
}
trap cleanup EXIT

ok()   { printf '  PASS  %s\n' "$1"; PASS=$((PASS + 1)); }
bad()  { printf '  FAIL  %s\n' "$1"; FAIL=$((FAIL + 1)); }
skip() { printf '  SKIP  %s\n' "$1"; SKIP=$((SKIP + 1)); }

# check <label> <expected-substring> <curl args...>
# An empty expected substring means "expect any real answer, not a transport error".
check() {
	local label="$1" want="$2"
	shift 2
	local got
	got=$(curl -sS --max-time 10 "$@" 2>&1)
	if printf '%s' "$got" | grep -q 'curl: ('; then
		bad "$label  (transport error)"
		printf '        got: %.160s\n' "$got"
		return
	fi
	if [ -z "$want" ]; then
		ok "$label"
		return
	fi
	if printf '%s' "$got" | grep -qF "$want"; then ok "$label"; else
		bad "$label  (wanted $want)"
		printf '        got: %.160s\n' "$got"
	fi
}

# classify_convex <url> -> dead | empty | serving
#
#   dead    : nothing answers /version            -> the auth spec cannot run at all
#   empty   : answers, but no functions pushed     -> the auth spec self-skips
#   serving : answers and resolves functions       -> the auth spec really runs
#
# The URL used to be hardcoded to a dead port (:9999), which turned four security
# assertions into a permanent silent skip while the step still printed PASS.
classify_convex() {
	local url="${1%/}" seen
	curl -sS --max-time 3 -o /dev/null "$url/version" 2>/dev/null || { printf 'dead'; return; }
	seen=$(curl -sS --max-time 5 -X POST "$url/api/query" \
		-H 'Content-Type: application/json' \
		-d '{"path":"devices:list","args":{},"format":"json"}' 2>/dev/null)
	if printf '%s' "$seen" | grep -q 'Could not find public function'; then
		printf 'empty'
	else
		printf 'serving'
	fi
}

printf '\n=== codex-clone-placeholder quick test ===\n'

printf 'commit: %s\n' "$(git rev-parse --short HEAD)"
printf 'branch: %s\n\n' "$(git rev-parse --abbrev-ref HEAD)"

printf '[1/5] static gates\n'
if npx prettier --check . >/dev/null 2>&1; then ok "prettier"; else bad "prettier"; fi
if npx eslint . >/dev/null 2>&1; then ok "eslint"; else bad "eslint"; fi
if npx tsc --noEmit -p src/convex >/dev/null 2>&1; then ok "tsc -p src/convex"; else bad "tsc -p src/convex"; fi

printf '\n[2/5] unit tests\n'
# The Convex spec proves the auth boundary, but only against a deployment that serves
# functions. Anything less and it either self-skips or fails on the empty deployment, so
# classify first and never let that state render as PASS. This step must not fail because
# the local deployment is empty — that is external state, not a repo defect — but it must
# never be counted as proof either.
CONVEX="${CONVEX_URL:-http://127.0.0.1:3210}"
CONVEX_SPEC='src/convex/deployment.spec.ts'
convex_state=$(classify_convex "$CONVEX")
case "$convex_state" in
dead) convex_why="no deployment answers (auth boundary NOT exercised)" ;;
empty) convex_why="deployment has no functions pushed (auth boundary NOT exercised)" ;;
serving) convex_why="" ;;
esac

if CONVEX_URL="$CONVEX" npx vitest run --reporter=dot >/tmp/clone-unit.log 2>&1; then
	vitest_pass=$(grep -oE 'Tests +[0-9]+ passed' /tmp/clone-unit.log | head -1)
	if [ -n "$convex_why" ]; then
		skip "vitest ${vitest_pass#Tests } on $CONVEX — convex: $convex_why"
	else
		ok "vitest $vitest_pass"
	fi
elif [ -n "$convex_why" ] && [ "$(grep -cE '^ *FAIL .*src/convex/deployment\.spec\.ts' /tmp/clone-unit.log)" -gt 0 ] &&
	! grep -E '^ *FAIL ' /tmp/clone-unit.log | grep -qv "$CONVEX_SPEC"; then
	# Every failure belongs to the auth spec, which cannot pass without a serving
	# deployment. Report the rest, and say out loud what was never proven.
	skip "vitest $(grep -oE 'Tests +[0-9]+ passed' /tmp/clone-unit.log | head -1) on $CONVEX — convex: $convex_why"
else
	bad "vitest"
	tail -15 /tmp/clone-unit.log
fi

printf '\n[3/5] build\n'
if [ "${1:-}" != "--no-build" ]; then
	if DEPLOY_TARGET=node bun run build >/tmp/clone-build.log 2>&1; then ok "bun run build"; else
		bad "bun run build"
		tail -20 /tmp/clone-build.log
	fi
else
	skip "build (--no-build)"
fi

printf '\n[4/5] boot + feature probes\n'
# Feature flags on purpose: every capability route must answer, not 404.
AUTH_ENABLED=false \
AI_ENABLED=false \
MCP_CLIENT_ENABLED=false \
MCP_SERVER_ENABLED=false \
MCP_SERVER_TOKEN="$(printf 'x%.0s' {1..40})" \
PUBLIC_SITE_URL="http://127.0.0.1:${PORT}" \
PUBLIC_SEO_INDEXABLE=false \
PORT="$PORT" HOST=127.0.0.1 \
node build/index.js >/tmp/clone-server.log 2>&1 &
PID=$!

for _ in $(seq 1 40); do
	curl -s -o /dev/null --max-time 1 "$BASE/" && break
	sleep 0.25
done

if curl -s -o /dev/null --max-time 2 "$BASE/"; then ok "server booted on :$PORT"; else
	bad "server booted on :$PORT"
	tail -20 /tmp/clone-server.log
fi

# The shell: menubar landmark is server-rendered; the composer heading is hydrated
# client-side, so asserting its text on raw HTML would be wrong. Playwright covers that.
check "shell renders (menubar)"      "Workspace menu"  "$BASE/"
check "shell hydrates (Svelte boot)" "__sveltekit"     "$BASE/"

# Capability surface must report state, not 404.
check "GET /api/ai/config"           '"ai"'            "$BASE/api/ai/config"
check "GET /api/mcp/server (POST-only)" "" -X POST "$BASE/api/mcp/server" \
	-H 'Content-Type: application/json' -d '{}'
check "GET /robots.txt"              "User-agent"      "$BASE/robots.txt"
check "GET /sitemap.xml"             "<urlset"         "$BASE/sitemap.xml"

# A disabled capability must say so rather than pretend.
check "disabled AI chat refuses"     "" -X POST "$BASE/api/ai/chat" \
	-H 'Content-Type: application/json' -d '{}'

printf '\n[5/5] browser smoke (desktop viewport)\n'
if npx playwright test --config playwright.dev.config.ts --reporter=line >/tmp/clone-e2e.log 2>&1; then
	ok "playwright dev-smoke $(grep -oE '[0-9]+ passed' /tmp/clone-e2e.log | head -1)"
else
	bad "playwright dev-smoke"
	tail -20 /tmp/clone-e2e.log
fi

printf '\n=== %d passed, %d failed, %d skipped ===\n' "$PASS" "$FAIL" "$SKIP"
# ponytail: shared via a tmp file because qcheck is a separate process; fold the two scripts
# together if a third reader ever needs this.
printf '%d\n' "$SKIP" >"$SKIP_FILE"
[ "$FAIL" -eq 0 ]
