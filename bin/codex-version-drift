#!/usr/bin/env python3
"""Report whether the installed Codex app changed under our feet.

The app is an MSIX (`OpenAI.Codex`). It updates itself through the Microsoft Store,
so we never pin a version and never sign anything. What *can* drift is our side:

  * the app rewrites keys in the clone config between runs (CONTRACT §6),
  * a new build can rename or drop the config keys we depend on,
  * the model catalog pins slug names the gateway must still serve,
  * the plugin cache path and the MSIX identity can move.

This records a fingerprint of everything our tooling depends on, and compares it to
the last recorded fingerprint. It answers one question: *did the app change, and did
our assumptions survive it?* It never blocks a launch — it reports, and exits 1 when
something we rely on moved.

Usage:
  codex-version-drift record            # take a fingerprint now (default)
  codex-version-drift check             # compare against the last fingerprint
  codex-version-drift check --json      # machine-readable
  codex-version-drift --help

Exit: 0 nothing drifted, 1 drift detected, 2 could not measure.
"""
import argparse
import hashlib
import json
import os
import re
import subprocess
import sys

STATE_NAME = "version-drift.json"

# Every key our launcher re-asserts, and therefore every key whose disappearance or
# rename would break a clone launch. Derived from CONTRACT.md §6 and §8, not invented.
LOAD_BEARING = [
    ("[windows] sandbox", r'^\s*sandbox\s*=', "windows"),
    ("top-level model", r'^\s*model\s*=', None),
    ("top-level model_provider", r'^\s*model_provider\s*=', None),
    ("chrome plugin", r'chrome@openai-bundled', None),
    ("sandbox_mode", r'^\s*sandbox_mode\s*=', None),
]


def state_dir():
    base = os.environ.get("CODEX_HOME") or os.path.join(os.path.expanduser("~"), ".codex")
    return os.path.join(base, "version-drift")


def wsl_path(p):
    """Translate a Windows path from the environment into something Python can open."""
    if not p:
        return p
    if re.match(r'^[A-Za-z]:[\\/]', p) or "\\" in p:
        drive = p[0].lower()
        rest = p[2:].replace("\\", "/").lstrip("/")
        return f"/mnt/{drive}/{rest}"
    return p


def read_text(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return None


def parse_toml_keys(text):
    """Collect the keys present per section, without a TOML dependency.

    We only need *presence of a key name*, not values: a renamed or removed key is the
    signal, and a value changing between runs is normal."""
    keys = set()
    section = ""
    for line in (text or "").splitlines():
        line = line.split("#", 1)[0].rstrip()
        if not line:
            continue
        m = re.match(r'^\[([^\]]+)\]$', line.strip())
        if m:
            section = m.group(1).strip()
            continue
        m = re.match(r'^([A-Za-z0-9_.\-"]+)\s*=', line.strip())
        if m:
            key = m.group(1).strip().strip('"')
            keys.add(f"{section}.{key}" if section else key)
    return keys


def msix_identity():
    """Read the installed MSIX identity. Windows only; absent elsewhere is not an error."""
    try:
        out = subprocess.run(
            ["powershell.exe", "-NoProfile", "-Command",
             "(Get-AppxPackage -Name OpenAI.Codex | Select-Object -First 1 "
             "Name,Version,Architecture,PackageFullName | ConvertTo-Json -Compress)"],
            capture_output=True, text=True, timeout=60,
        )
        if out.returncode == 0 and out.stdout.strip():
            return json.loads(out.stdout.strip())
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        pass
    return None


def fingerprint(home):
    """Everything our tooling depends on, in one comparable structure."""
    facts = {"home": home}

    config_path = os.path.join(home, "config.toml")
    text = read_text(config_path)
    facts["config_present"] = text is not None
    facts["config_keys"] = sorted(parse_toml_keys(text))

    # Which load-bearing patterns are still findable in the file as written.
    present = {}
    for label, pattern, _section in LOAD_BEARING:
        present[label] = bool(re.search(pattern, text or "", re.MULTILINE))
    facts["load_bearing"] = present

    # The catalog is a separate file the app reads; its shape is our contract with it.
    catalog_path = None
    m = re.search(r'^\s*model_catalog_json\s*=\s*"([^"]+)"', text or "", re.MULTILINE)
    if m:
        catalog_path = wsl_path(m.group(1))
    facts["catalog_path"] = catalog_path
    if catalog_path:
        raw = read_text(catalog_path)
        facts["catalog_present"] = raw is not None
        if raw:
            try:
                cat = json.loads(raw)
                models = cat.get("models") or []
                facts["catalog_models"] = len(models)
                # The two fields tool calling cannot survive without (CONTRACT §8).
                facts["catalog_missing_fields"] = [
                    mm.get("slug") or mm.get("id") or "?"
                    for mm in models
                    if mm.get("tool_mode") != "code_mode_only"
                    or mm.get("use_responses_lite") is not False
                ]
                facts["catalog_slugs_hash"] = hashlib.sha256(
                    "\n".join(sorted(str(mm.get("slug") or mm.get("id")) for mm in models)).encode()
                ).hexdigest()[:16]
            except (json.JSONDecodeError, OSError):
                facts["catalog_parse_error"] = True

    facts["msix"] = msix_identity()
    return facts


def load_previous():
    p = os.path.join(state_dir(), STATE_NAME)
    raw = read_text(p)
    if not raw:
        return None
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return None


def save_state(facts):
    d = state_dir()
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, STATE_NAME), "w", encoding="utf-8") as fh:
        json.dump(facts, fh, indent=2, sort_keys=True)
        fh.write("\n")


def diff(prev, now):
    """Only report things that would actually break a launch."""
    problems = []

    if not now["config_present"]:
        problems.append(("config-missing", "the clone config.toml is gone"))
    elif prev["config_present"]:
        lost = sorted(set(prev["config_keys"]) - set(now["config_keys"]))
        if lost:
            problems.append(("config-keys-removed",
                             "app no longer writes: " + ", ".join(lost[:8])))
        gained = sorted(set(now["config_keys"]) - set(prev["config_keys"]))
        if gained:
            problems.append(("config-keys-added",
                             "app started writing: " + ", ".join(gained[:8]) + " (harmless, but re-read CONTRACT)"))

    for label, was, is_now in [
        (lbl, prev["load_bearing"].get(lbl), now["load_bearing"].get(lbl))
        for lbl in prev["load_bearing"]
    ]:
        if was and not is_now:
            problems.append(("load-bearing-key-vanished", f"{label} can no longer be found in config.toml"))

    if prev.get("catalog_slugs_hash") and now.get("catalog_slugs_hash") \
            and prev["catalog_slugs_hash"] != now["catalog_slugs_hash"]:
        problems.append(("catalog-slugs-changed",
                         "the model list changed; re-run codex-9router-catalog to verify names still resolve"))

    missing_fields = now.get("catalog_missing_fields") or []
    if missing_fields:
        problems.append(("catalog-entry-unusable",
                         f"{len(missing_fields)} entries lack tool_mode/use_responses_lite: "
                         + ", ".join(missing_fields[:5])))

    pm, nm = prev.get("msix"), now.get("msix")
    if pm and nm and pm.get("Version") != nm.get("Version"):
        problems.append(("app-updated", f"{pm.get('Version')} -> {nm.get('Version')} "
                                        "(expected; the launcher re-asserts its keys on next clone launch)"))
    return problems


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("command", nargs="?", default="record", choices=["record", "check"])
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--home", default=os.environ.get("CODEX_HOME")
                    or os.path.join(os.path.expanduser("~"), ".codex-clone"))
    args = ap.parse_args()

    now = fingerprint(args.home)

    if args.command == "record":
        save_state(now)
        if args.json:
            print(json.dumps(now, indent=2, sort_keys=True))
        else:
            print(f"recorded {os.path.join(state_dir(), STATE_NAME)}")
            print(f"  config keys      {len(now['config_keys'])}")
            if now.get("catalog_models"):
                print(f"  catalog models   {now['catalog_models']}")
            if now.get("msix"):
                print(f"  app version      {now['msix'].get('Version')}")
        return 0

    prev = load_previous()
    if prev is None:
        print("no fingerprint recorded yet — run `codex-version-drift record`", file=sys.stderr)
        return 2

    problems = diff(prev, now)
    if args.json:
        print(json.dumps({"problems": [{"id": a, "detail": b} for a, b in problems]}, indent=2))
    else:
        if not problems:
            print("OK  nothing our tooling depends on has moved")
        for pid, detail in problems:
            print(f"  {pid}: {detail}")

    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
