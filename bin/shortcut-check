#!/usr/bin/env bash
# Prove the desktop shortcuts still point at THIS checkout, and that their icons still exist.
#
#   bin/shortcut-check            # check the Desktop against this repo
#   bin/shortcut-check -v         # also print the resolved paths on every line
#
# Exit code is non-zero when any shortcut fails or when the desktop cannot be read at all.
# "Could not check" is never a pass — same rule as bin/isolation-check.
#
# Read-only: the .lnk files are opened through WScript.Shell and never saved.
set -uo pipefail

VERBOSE=no
for arg in "$@"; do
	case "$arg" in
	-v | --verbose) VERBOSE=yes ;;
	-h | --help)
		sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
		exit 0
		;;
	*)
		printf 'unknown argument: %s\n' "$arg" >&2
		exit 2
		;;
	esac
done

REPO=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

# The desktop must point at the durable checkout, never at a disposable worktree: this repo is
# routinely checked out into /home/rahman/projects/manef/cd-dN for parallel work, and those come
# and go. git knows which checkout is the main one, so ask it instead of hardcoding a path.
main_worktree() {
	git -C "$1" worktree list --porcelain 2>/dev/null | awk '/^worktree /{ print substr($0, 10); exit }'
}
CANON=${SHORTCUT_REPO:-$(main_worktree "$REPO")}
[ -n "$CANON" ] || CANON=$REPO
CANON=$(cd -- "$CANON" 2>/dev/null && pwd) || CANON=$REPO

LAUNCHER="$CANON/scripts/codex-launch.ps1"
SELF_LAUNCHER="$REPO/scripts/codex-launch.ps1"

PASS=0
FAIL=0
ok()   { printf '  PASS  %s\n' "$1"; PASS=$((PASS + 1)); }
bad()  { printf '  FAIL  %s\n' "$1"; FAIL=$((FAIL + 1)); }
info() { printf '  INFO  %s\n' "$1"; }
note() { [ "$VERBOSE" = yes ] && printf '        %s\n' "$1"; return 0; }

if ! command -v powershell.exe >/dev/null 2>&1; then
	printf '  FAIL  powershell.exe not on PATH: shortcut inspection needs Windows interop.\n' >&2
	exit 2
fi

# The shortcuts must run the launcher over the \\wsl.localhost share. powershell.exe on Windows
# cannot open a POSIX path, so the expected target is computed with wslpath rather than assumed.
if ! REPO_WIN=$(wslpath -w "$CANON" 2>/dev/null) || [ -z "$REPO_WIN" ]; then
	printf '  FAIL  cannot map %s to a Windows path (wslpath failed).\n' "$CANON" >&2
	exit 2
fi
LAUNCHER_WIN="$REPO_WIN\\scripts\\codex-launch.ps1"

printf '\n=== shortcut check ===\n'
printf 'repo:      %s\n' "$CANON"
[ "$REPO" = "$CANON" ] || printf 'checked from: %s (worktree; the desktop must target the checkout above)\n' "$REPO"
printf 'launcher:  %s\n\n' "$LAUNCHER_WIN"

# One PowerShell round trip emits everything the checks need as tab-separated records:
#   PKG <version> <installlocation>
#   DESKTOP <path>
#   LNK <name> <target> <script> <icon> <targetExists> <scriptExists> <iconExists> <scriptHash> <desc>
# File existence is answered by Windows because these are Windows paths; doing it in bash would
# mean guessing what \\wsl.localhost and C:\ mean, which is how the original bug survived.
PS=$(cat <<'EOF'
$sh = New-Object -ComObject WScript.Shell
$pkg = Get-AppxPackage -Name OpenAI.Codex -ErrorAction SilentlyContinue | Select-Object -First 1
if ($pkg) { "PKG`t$($pkg.Version)`t$($pkg.InstallLocation)" } else { "PKG`t`t" }
$desktop = [Environment]::GetFolderPath('Desktop')
if (-not $desktop) { $desktop = Join-Path $env:USERPROFILE 'Desktop' }
"DESKTOP`t$desktop"
Get-ChildItem -LiteralPath $desktop -Filter *.lnk -File -ErrorAction SilentlyContinue | ForEach-Object {
    $l = $sh.CreateShortcut($_.FullName)
    $args = [string]$l.Arguments
    $script = ''
    if ($args -match '-File\s+"([^"]+)"') { $script = $Matches[1] }
    elseif ($args -match '-File\s+(\S+)') { $script = $Matches[1] }
    $icon = [string]$l.IconLocation
    $iconFile = $icon -replace ',\s*-?\d+$', ''
    $te = $false; $se = $false; $ie = $false; $hash = ''
    if ($l.TargetPath) { $te = Test-Path -LiteralPath $l.TargetPath }
    if ($script) {
        $se = Test-Path -LiteralPath $script
        if ($se) { try { $hash = (Get-FileHash -LiteralPath $script -Algorithm SHA256).Hash } catch { $hash = '' } }
    }
    if ($iconFile) { $ie = Test-Path -LiteralPath $iconFile }
    "LNK`t$($_.Name)`t$($l.TargetPath)`t$script`t$iconFile`t$te`t$se`t$ie`t$hash`t$($l.Description)"
}
EOF
)

ENCODED=$(printf '%s' "$PS" | iconv -f UTF-8 -t UTF-16LE | base64 -w0)
if ! RAW=$(powershell.exe -NoProfile -EncodedCommand "$ENCODED" 2>/dev/null); then
	printf '  FAIL  powershell.exe could not inspect the Desktop shortcuts.\n' >&2
	exit 2
fi
RAW=$(printf '%s\n' "$RAW" | tr -d '\r' | grep -E '^(PKG|DESKTOP|LNK)\s' || true)

DESKTOP=$(printf '%s\n' "$RAW" | awk -F'\t' '$1 == "DESKTOP" { print $2; exit }')
if [ -z "$DESKTOP" ]; then
	printf '  FAIL  could not read the Desktop path from Windows.\n' >&2
	exit 2
fi
info "desktop: $DESKTOP"

PKG_VERSION=$(printf '%s\n' "$RAW" | awk -F'\t' '$1 == "PKG" { print $2; exit }')
PKG_ROOT=$(printf '%s\n' "$RAW" | awk -F'\t' '$1 == "PKG" { print $3; exit }')
if [ -z "$PKG_VERSION" ]; then
	bad "OpenAI.Codex is not registered for this user (Get-AppxPackage returned nothing)"
else
	ok "OpenAI.Codex $PKG_VERSION is installed at $PKG_ROOT"
fi

# ------------------------------------------------------------------------------ per shortcut
#
# A shortcut belongs to this check when it launches any codex-launch.ps1. Matching on the name
# instead would silently skip a renamed leftover, which is exactly the failure being hunted.
CODEX_COUNT=0
LAUNCHER_LOWER=$(printf '%s' "$LAUNCHER_WIN" | tr '[:upper:]' '[:lower:]')
FOUND_REPO_TARGET=no

while IFS=$'\t' read -r tag name target script icon texists sexists iexists shash desc; do
	[ "$tag" = "LNK" ] || continue
	case "$desc$script" in
	*codex-launch.ps1*) : ;;
	*) continue ;;
	esac
	CODEX_COUNT=$((CODEX_COUNT + 1))
	printf '\n%s\n' "$name"

	# 1. the thing the shortcut starts must exist
	if [ "$texists" = "True" ]; then
		ok "target exists"
		note "$target"
	else
		bad "target missing: $target"
	fi

	# 2. the launcher must be this checkout's, reached over the share
	SCRIPT_LOWER=$(printf '%s' "$script" | tr '[:upper:]' '[:lower:]')
	if [ -z "$script" ]; then
		bad "no -File argument: nothing says which launcher runs"
	elif [ "$SCRIPT_LOWER" = "$LAUNCHER_LOWER" ]; then
		if [ "$sexists" = "True" ]; then
			ok "runs the repo launcher"
			FOUND_REPO_TARGET=yes
			note "$script"
			# Same path is not the same file: a sibling worktree at another path would fail
			# above, but a stale checkout left at THIS path would pass. Compare bytes.
			if [ -n "$shash" ]; then
				if [ "$(sha256sum -- "$LAUNCHER" | cut -d' ' -f1)" = "$(printf '%s' "$shash" | tr '[:upper:]' '[:lower:]')" ]; then
					ok "launcher on disk matches the one Windows would read"
				else
					bad "launcher differs from what Windows reads at that path (stale checkout, or an unsaved edit)"
				fi
			else
				bad "cannot hash the launcher Windows would run: $script"
			fi
		else
			bad "runs the repo launcher but it is unreadable from Windows: $script"
		fi
	elif [ "$SCRIPT_LOWER" = "$(printf '%s' "$DESKTOP\\codex-launch.ps1" | tr '[:upper:]' '[:lower:]')" ]; then
		bad "runs a STALE Desktop copy, not the repo: $script"
	elif printf '%s' "$SCRIPT_LOWER" | grep -q '\\cd-[a-z0-9-]*\\scripts\\codex-launch\.ps1$'; then
		bad "runs a disposable worktree, not the durable checkout: $script"
	else
		bad "runs a launcher outside the durable checkout ($CANON): $script"
	fi

	# 3. the icon must resolve to a file that is there right now
	if [ -z "$icon" ]; then
		bad "no icon path"
	elif [ "$iexists" = "True" ]; then
		ok "icon exists"
		note "$icon"
	else
		bad "icon path does not exist: $icon"
	fi

	# 4. the bug this replaces: an icon pointing into a version-stamped MSIX folder.
	#    Any MSIX path must belong to the package version installed NOW. Comparing against
	#    Get-AppxPackage is what makes this update-proof: after a Store update this line fails
	#    until install-shortcuts.ps1 is re-run, instead of silently going generic.
	case "$icon" in
	*WindowsApps*OpenAI.Codex_*)
		pinned=$(printf '%s' "$icon" | sed -n 's/.*OpenAI\.Codex_\([0-9][0-9.]*\)_.*/\1/p')
		if [ -z "$pinned" ]; then
			bad "icon is under WindowsApps but its version cannot be read: $icon"
		elif [ "$pinned" = "$PKG_VERSION" ]; then
			ok "icon resolves inside the installed package ($pinned)"
		else
			bad "icon is pinned to MSIX $pinned but $PKG_VERSION is installed: $icon"
		fi
		;;
	*WindowsApps*)
		bad "icon points into WindowsApps without a package version: $icon"
		;;
	*) : ;;
	esac
done <<<"$RAW"

# ------------------------------------------------------------------------------- whole-desktop
printf '\nwhole desktop\n'

# Exactly one: the clone. The real account is already named ChatGPT by the Store's Start Menu
# entry, so a second desktop icon for it is the duplication this check now rejects.
if [ "$CODEX_COUNT" -eq 0 ]; then
	bad "no shortcut launches codex-launch.ps1 - run: powershell -File scripts/install-shortcuts.ps1"
elif [ "$CODEX_COUNT" -eq 1 ]; then
	ok "1 codex shortcut"
else
	bad "$CODEX_COUNT codex shortcuts; expected 1 (the clone)"
fi

if [ "$FOUND_REPO_TARGET" = "yes" ]; then
	ok "at least one shortcut runs this checkout"
else
	bad "no shortcut runs this checkout"
fi

# The repository's launcher is what the shortcuts promise to run, so it has to be readable both
# ways: from bash (this checkout) and from Windows (over the share).
if [ -f "$LAUNCHER" ]; then
	ok "repo launcher present"
else
	bad "repo launcher missing: $LAUNCHER"
fi

printf '\n%s: %d passed, %d failed\n' "$([ "$FAIL" -eq 0 ] && echo OK || echo FAILED)" "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ] || exit 1
