#!/usr/bin/env python3
"""Local setup page for a Codex BYOK profile.

Why this exists: a new user has an OpenAI-compatible endpoint (OAuth-backed gateway, a
raw API key, or a custom URL) and needs three things written correctly before Codex can
use it — a `[model_providers.*]` table, the top-level `model`, and a catalog the app can
read. Getting those wrong is silent: the app opens, the model list is empty, and nothing
says why.

This serves ONE page on 127.0.0.1, writes the profile when the form is submitted, and
exits when the browser is done. It is stdlib only — no pip install, no npm, no build.

Security, because this holds a credential:
  * binds 127.0.0.1 only, never 0.0.0.0;
  * a random token in the URL path, so another local user cannot reach it blind;
  * POST only for the write, with the token checked again;
  * the key is never echoed back, never logged, and written 0600;
  * the process exits after one successful write, or after --timeout seconds.

Usage:
  codex-setup                      # serve, open the browser, wait
  codex-setup --no-browser         # print the URL instead
  codex-setup --port 8791
  codex-setup --timeout 900
  codex-setup --print-url-only

Exit: 0 a profile was written, 1 nothing written, 2 could not start.
"""
import argparse
import html
import json
import os
import secrets
import socket
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import webbrowser
from http.server import BaseHTTPRequestHandler, HTTPServer

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    import codex_home
except ImportError:
    codex_home = None

PAGE_TITLE = "Codex — connect a model"


# --------------------------------------------------------------------------- writing

PROFILE_TEMPLATE = '''# BYOK profile written by codex-setup on {when}.
{note}
model_provider = "{pid}"
model = "{model}"

[model_providers.{pid}]
name = "{display}"
base_url = "{base_url}"
{auth}
wire_api = "responses"
requires_openai_auth = false
'''


def clean_base_url(raw):
    """Normalise an endpoint. Returns (url, error).

    Accepts what people actually paste: with or without a trailing slash, with or without
    /v1, and a bare host. Codex appends `/responses`, so the stored value must end at the
    API root, not at the endpoint itself.
    """
    url = (raw or "").strip()
    if not url:
        return None, "base URL is required"
    if not (url.startswith("http://") or url.startswith("https://")):
        return None, "base URL must start with http:// or https://"
    url = url.rstrip("/")
    for suffix in ("/chat/completions", "/responses", "/completions"):
        if url.endswith(suffix):
            url = url[: -len(suffix)]
    if not url.endswith("/v1") and not urllib.parse.urlparse(url).path.endswith("/v1"):
        # Not every gateway uses /v1, so this is a hint rather than a rewrite. Appending it
        # blindly would 404 a gateway that serves at the root.
        pass
    return url, None


def write_profile(home, name, base_url, token, model, display):
    """Write `<home>/<name>.config.toml` mode 0600. Returns (path, backup_or_None)."""
    os.makedirs(home, exist_ok=True)
    pid = "byok_" + "".join(c if c.isalnum() else "_" for c in name).strip("_").lower()
    auth = f'experimental_bearer_token = "{token}"'
    note = ("# The key is stored INLINE in this file (mode 600). Codex cannot read a shell\n"
            "# environment on Windows, so this is the form that actually works.")
    body = PROFILE_TEMPLATE.format(
        when=time.strftime("%Y-%m-%d %H:%M"),
        note=note,
        pid=pid,
        display=display or name,
        base_url=base_url,
        auth=auth,
        model=model or "",
    )
    path = os.path.join(home, f"{name}.config.toml")
    backup = None
    if os.path.exists(path):
        backup = path + ".bak"
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            previous = fh.read()
        with open(backup, "w", encoding="utf-8") as fh:
            fh.write(previous)
    # Write, then chmod, then rename: a half-written profile is worse than none.
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(body)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
    return path, backup


def probe_endpoint(base_url, token, timeout=15):
    """Ask the endpoint which models it serves. Returns (ids, error).

    This is the difference between "saved" and "works": a profile pointing at a dead URL
    produces a Codex window with an empty model list and no explanation.
    """
    url = base_url.rstrip("/") + "/models"
    req = urllib.request.Request(url, headers={"Authorization": "Bearer " + token})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.load(resp)
        ids = [m.get("id") for m in data.get("data", []) if m.get("id")]
        return ids, None
    except urllib.error.HTTPError as e:
        return [], f"HTTP {e.code} {e.reason}"
    except urllib.error.URLError as e:
        return [], f"cannot reach it ({e.reason})"
    except (socket.timeout, json.JSONDecodeError, OSError) as e:
        return [], f"{type(e).__name__}: {e}"


# --------------------------------------------------------------------------- the page

