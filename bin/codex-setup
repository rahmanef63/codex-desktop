PAGE = """<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title><style>{css}</style></head>
<body><main>
<h1>{title}</h1>
<p class="sub">Writes one Codex profile so the app can talk to your endpoint. Nothing is
uploaded anywhere: this page is served from your own machine and closes when done.</p>

<form id="form">
<fieldset>
<legend>1 · Connection type</legend>
<div class="kind">
<label><input type="radio" name="kind" value="apikey" checked> API key</label>
<label><input type="radio" name="kind" value="oauth"> OAuth gateway</label>
<label><input type="radio" name="kind" value="custom"> Custom endpoint</label>
</div>
<p class="hint" id="kindhint">A bearer token your provider issued. Most common.</p>

<label for="base_url">Base URL</label>
<input id="base_url" name="base_url" placeholder="https://api.example.com/v1" required>
<p class="hint" id="urlhint">The API root. Codex appends <code>/responses</code> itself, so a
trailing <code>/chat/completions</code> is stripped.</p>

<label for="token" id="tokenlabel">API key</label>
<input id="token" name="token" type="password" placeholder="sk-..." required
       autocomplete="off" spellcheck="false">
<p class="hint">Stored inline in the profile, mode 0600. Never sent anywhere but your
endpoint, and never shown again after you submit.</p>
</fieldset>

<fieldset>
<legend>2 · Profile</legend>
<label for="name">Profile name</label>
<input id="name" name="name" value="local" pattern="[A-Za-z0-9._-]+" required>
<p class="hint">Becomes <code>&lt;name&gt;.config.toml</code>. Codex activates it with
<code>codex -p &lt;name&gt;</code>.</p>

<label for="model">Default model</label>
<input id="model" name="model" placeholder="left empty: the first served model">
<p class="hint">Leave blank and the page picks the first model your endpoint reports.</p>

<button type="button" id="test">Test connection</button>
<div class="status" id="status"></div>
<pre id="out" class="hidden"></pre>
</fieldset>

<div class="row">
<button type="submit" class="primary" id="save" disabled>Save profile</button>
<span class="hint">Enabled after a successful test.</span>
</div>
</form>
</main>
<script>
const TOKEN = {token_literal};
const form = document.getElementById('form');
const statusEl = document.getElementById('status');
const out = document.getElementById('out');
const saveBtn = document.getElementById('save');
const testBtn = document.getElementById('test');

const HINTS = {{
  apikey: ['A bearer token your provider issued. Most common.',
           'The API root, e.g. https://api.openai.com/v1', 'API key'],
  oauth:  ['A gateway that holds the OAuth session for you. The value below is its bearer token, not a browser cookie.',
           'Your gateway root, e.g. http://127.0.0.1:20128/v1', 'Gateway token'],
  custom: ['Any OpenAI-compatible server: a local runtime, a proxy, a self-hosted gateway.',
           'Whatever your server exposes, e.g. http://127.0.0.1:8080/v1', 'Token (blank if none)']
}};
function syncKind() {{
  const k = form.kind.value;
  const [kh, uh, tl] = HINTS[k];
  document.getElementById('kindhint').textContent = kh;
  document.getElementById('urlhint').innerHTML = uh;
  document.getElementById('tokenlabel').textContent = tl;
  if (k === 'custom') document.getElementById('token').required = false;
  else document.getElementById('token').required = true;
  saveBtn.disabled = true;
}}
form.querySelectorAll('input[name=kind]').forEach(r => r.onchange = syncKind);

function payload() {{
  return {{
    base_url: document.getElementById('base_url').value.trim(),
    token: document.getElementById('token').value.trim(),
    name: document.getElementById('name').value.trim(),
    model: document.getElementById('model').value.trim(),
    kind: form.kind.value
  }};
}}

async function post(path, body) {{
  const r = await fetch(path, {{
    method: 'POST',
    headers: {{'Content-Type': 'application/json', 'X-Setup-Token': TOKEN}},
    body: JSON.stringify(body)
  }});
  return await r.json();
}}

testBtn.onclick = async () => {{
  statusEl.className = 'status';
  statusEl.textContent = 'Testing…';
  out.classList.add('hidden');
  saveBtn.disabled = true;
  try {{
    const res = await post('/api/test', payload());
    if (res.ok) {{
      statusEl.className = 'status ok';
      statusEl.textContent = res.models.length + ' model(s) reachable. Pick one below, then save.';
      out.classList.remove('hidden');
      out.textContent = res.models.join('\\n');
      const modelInput = document.getElementById('model');
      if (!modelInput.value && res.models.length) modelInput.placeholder = res.models[0];
      saveBtn.disabled = false;
    }} else {{
      statusEl.className = 'status bad';
      statusEl.textContent = res.error || 'failed';
    }}
  }} catch (e) {{
    statusEl.className = 'status bad';
    statusEl.textContent = 'request failed: ' + e;
  }}
}};

form.onsubmit = async (ev) => {{
  ev.preventDefault();
  saveBtn.disabled = true;
  statusEl.className = 'status';
  statusEl.textContent = 'Saving…';
  try {{
    const res = await post('/api/save', payload());
    if (res.ok) {{
      statusEl.className = 'status ok';
      statusEl.textContent = res.message;
      out.classList.remove('hidden');
      out.textContent = res.detail || '';
      document.getElementById('token').value = '';
    }} else {{
      statusEl.className = 'status bad';
      statusEl.textContent = res.error || 'failed';
      saveBtn.disabled = false;
    }}
  }} catch (e) {{
    statusEl.className = 'status bad';
    statusEl.textContent = 'request failed: ' + e;
    saveBtn.disabled = false;
  }}
}};
syncKind();
</script></body></html>
"""

DONE_PAGE = """<!doctype html><html lang="en"><head><meta charset="utf-8">
<title>Profile saved</title><style>{css}</style></head><body><main>
<h1>Profile saved</h1>
<p class="sub">You can close this tab. The setup process has exited.</p>
<pre>profile : {path}{backup}
home    : {home}
model   : {model}

Next:
  codex -p {name}         # run Codex with this profile
  bin/codex-byok profile list   # verify it is readable</pre>
</main></body></html>
"""


def model_list_html(ids):
    return "\n".join(html.escape(i) for i in ids)


# --------------------------------------------------------------------------- server

class State:
    def __init__(self, home, timeout):
        self.home = home
        self.timeout = timeout
        self.token = secrets.token_urlsafe(24)
        self.saved = None  # {"path":..., "name":..., "model":..., "backup":...}
        self.started = time.time()


def make_handler(state):
    class Handler(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, fmt, *args):
            # Silence the default stderr spam: it would print query strings.
            return

        def _send(self, code, body, ctype="application/json"):
            raw = body.encode("utf-8") if isinstance(body, str) else body
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            self.wfile.write(raw)

        def _authorised(self):
            # The token lives in the URL for the page, and in a header for the API. A blind
            # scan of localhost ports cannot guess it.
            supplied = self.headers.get("X-Setup-Token") or ""
            return secrets.compare_digest(supplied, state.token)

        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            parts = parsed.path.strip("/").split("/")
            if len(parts) == 2 and parts[0] == "s" and secrets.compare_digest(parts[1], state.token):
                body = PAGE.format(title=PAGE_TITLE, css=CSS,
                                   token_literal=json.dumps(state.token))
                self._send(200, body, "text/html; charset=utf-8")
                return
            if parsed.path == "/" and state.saved:
                b = state.saved
                body = DONE_PAGE.format(css=CSS, path=html.escape(b["path"]),
                                        backup=f"\nbackup  : {b['backup']}" if b["backup"] else "",
                                        home=html.escape(state.home),
                                        model=html.escape(b["model"] or "(endpoint default)"),
                                        name=html.escape(b["name"]))
                self._send(200, body, "text/html; charset=utf-8")
                return
            self._send(404, json.dumps({"ok": False, "error": "not found"}))

        def do_POST(self):
            if not self._authorised():
                self._send(403, json.dumps({"ok": False, "error": "bad setup token"}))
                return
            length = int(self.headers.get("Content-Length") or 0)
            if length > 64 * 1024:
                self._send(413, json.dumps({"ok": False, "error": "body too large"}))
                return
            try:
                body = json.loads(self.rfile.read(length) or b"{}")
            except json.JSONDecodeError:
                self._send(400, json.dumps({"ok": False, "error": "invalid JSON"}))
                return

            if self.path == "/api/test":
                url, err = clean_base_url(body.get("base_url"))
                if err:
                    self._send(200, json.dumps({"ok": False, "error": err}))
                    return
                token = (body.get("token") or "").strip()
                if not token and body.get("kind") != "custom":
                    self._send(200, json.dumps({"ok": False, "error": "an API key is required"}))
                    return
                ids, perr = probe_endpoint(url, token or "none")
                if perr:
                    self._send(200, json.dumps({"ok": False, "error": perr}))
                    return
                self._send(200, json.dumps({"ok": True, "models": ids[:200]}))
                return

            if self.path == "/api/save":
                url, err = clean_base_url(body.get("base_url"))
                if err:
                    self._send(200, json.dumps({"ok": False, "error": err}))
                    return
                name = (body.get("name") or "").strip()
                if not name or any(c not in "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-" for c in name):
                    self._send(200, json.dumps({"ok": False, "error": "profile name may only use letters, digits, dot, underscore, dash"}))
                    return
                token = (body.get("token") or "").strip()
                model = (body.get("model") or "").strip()
                # A model that the endpoint does not serve is the most common silent failure, so
                # resolve it here rather than letting Codex open with an empty list.
                ids, perr = probe_endpoint(url, token or "none")
                if perr:
                    self._send(200, json.dumps({"ok": False, "error": f"cannot save: {perr}"}))
                    return
                if not model:
                    model = ids[0] if ids else ""
                elif model not in ids:
                    self._send(200, json.dumps({
                        "ok": False,
                        "error": f"'{model}' is not served by this endpoint. Served: "
                                 + ", ".join(ids[:8]) + ("…" if len(ids) > 8 else "")}))
                    return
                try:
                    path, backup = write_profile(state.home, name, url, token, model, name)
                except OSError as e:
                    self._send(200, json.dumps({"ok": False, "error": f"cannot write: {e}"}))
                    return
                state.saved = {"path": path, "name": name, "model": model, "backup": backup}
                detail = ", ".join(ids[:20]) if ids else "(endpoint reported no model list)"
                self._send(200, json.dumps({
                    "ok": True,
                    "message": f"Saved. Run: codex -p {name}",
                    "detail": f"{path}\n{len(ids)} model(s): {detail}"}))
                return

            self._send(404, json.dumps({"ok": False, "error": "not found"}))

    return Handler


def pick_port(preferred):
    """Prefer the requested port, fall back to any free one. Never fail for that reason."""
    if preferred:
        try:
            with socket.socket() as s:
                s.bind(("127.0.0.1", preferred))
            return preferred
        except OSError:
            pass
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--home", default=None, help="CODEX_HOME to write the profile into")
    ap.add_argument("--port", type=int, default=8790)
    ap.add_argument("--timeout", type=int, default=900, help="exit after N seconds (default 900)")
    ap.add_argument("--no-browser", action="store_true")
    ap.add_argument("--print-url-only", action="store_true")
    args = ap.parse_args()

    home = args.home
    if not home:
        if codex_home is None:
            home = os.path.join(os.path.expanduser("~"), ".codex")
        else:
            resolved = codex_home.resolve()
            home = resolved.get("real") or resolved.get("clone")
            if not home:
                print("cannot resolve a Codex home; pass --home", file=sys.stderr)
                return 2

    port = pick_port(args.port)
    state = State(home, args.timeout)
    url = f"http://127.0.0.1:{port}/s/{state.token}"

    if args.print_url_only:
        print(url)
        return 0

    try:
        httpd = HTTPServer(("127.0.0.1", port), make_handler(state))
    except OSError as e:
        print(f"cannot bind 127.0.0.1:{port}: {e}", file=sys.stderr)
        return 2

    sys.stdout.reconfigure(line_buffering=True)
    print(f"setup page: {url}")
    print(f"writing to: {home}")
    print("leave this running; it exits after you save, or after "
          f"{args.timeout}s. Ctrl-C cancels.")

    if not args.no_browser:
        threading.Thread(target=lambda: webbrowser.open(url), daemon=True).start()

    httpd.timeout = 1.0
    while not state.saved and (time.time() - state.started) < args.timeout:
        httpd.handle_request()

    httpd.server_close()
    if state.saved:
        b = state.saved
        print(f"\nsaved  {b['path']}")
        if b["backup"]:
            print(f"backup {b['backup']}")
        print(f"model  {b['model'] or '(endpoint default)'}")
        print(f"\nrun:  codex -p {b['name']}")
        return 0
    print("\nnothing saved — timed out or cancelled", file=sys.stderr)
    return 1


if __name__ == "__main__":
    # Line-buffered unconditionally: this tool's whole job is to print a URL that a user or a
    # wrapper script must read while it is still running. Block buffering on a pipe breaks that.
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except (AttributeError, OSError):
        pass
    sys.exit(main())
