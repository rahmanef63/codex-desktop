# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem
9router.config.toml
auth.json

# MSO runtime state — never commit.
# `.mso/` holds account.json, config.json, private/, agent-session-archive/ and 3.5k files of
# local orchestration state. It is machine-local by design; committing it would publish
# credentials and session history.
.mso/
mso.local/
*.mso.local

# Local activity log
.local-logs/

# Progress and working notes that must stay off the repo
progress.local.md
PROGRESS.local.md
*.progress.local.*

# Dependencies and Electron build output — reproducible, never committed
node_modules/
app/dist/

# Machine-local artifacts
*.log
*.sqlite
*.sqlite-wal
*.sqlite-shm
.evidence/
parity-evidence/*.raw

# Editors
.DS_Store
Thumbs.db
.vscode/
.idea/
