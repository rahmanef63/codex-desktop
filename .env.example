# Copy to your own profile, not into this repository.
#
# The real file lives at ~/.codex/9router.config.toml and is read by the launcher when it seeds
# a clone home. Nothing here is committed with a value.

# The 9router (or any OpenAI-compatible) gateway this profile talks to.
[mcp_servers]
# optional; see docs/PROGRESS.md

[model_providers.nine_router]
name = "9router"
base_url = "https://your-gateway.example/v1"
wire_api = "responses"
requires_openai_auth = false
# Generate your own. Never reuse a token that has appeared in a transcript.
experimental_bearer_token = "REPLACE_ME"

# The two fields that make tool calling work through a translating gateway.
# Without them chat works and every tool fails with `unsupported call`.
# They live in the catalog, not here — this comment is the reminder.
#
#   tool_mode          = "code_mode_only"
#   use_responses_lite = false
